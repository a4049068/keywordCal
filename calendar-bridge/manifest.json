{
  "manifest_version": 2,
  "name": "KeywordCal Calendar Bridge",
  "version": "1.4.0",
  "description": "Companion add-on that gives KeywordCal direct write access to Thunderbird calendars: events/tasks are filed silently into the calendar you pick per rule, with no compose windows. Install alongside KeywordCal.",
  "homepage_url": "https://example.com/keywordcal/",
  "developer": {
    "name": "Your Name"
  },
  "permissions": [
    "storage"
  ],
  "author": "Your Name",
  "applications": {
    "gecko": {
      "id": "keywordcal-bridge@yourdomain.com",
      "strict_min_version": "128.0"
    }
  },
  "experiment_apis": {
    "BridgeParent": {
      "schema": "schema.json",
      "parent": {
        "scopes": [
          "main",
          "addon_parent"
        ],
        "paths": [
          [
            "BridgeParent"
          ]
        ],
        "script": "api.js"
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  }
}
